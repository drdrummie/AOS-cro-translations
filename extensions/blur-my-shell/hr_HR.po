#: effects/blur/info.js:7
msgid "Dual Kawase blur"
msgstr "Dvostruko Kawaseovo zamućenje"

#: effects/blur/info.js:8
msgid "A fast, high-quality blur."
msgstr "Brzo, visokokvalitetno zamućenje."

#: effects/blur/info.js:11
msgid "Radius"
msgstr "Polumjer"

#: effects/blur/info.js:12
msgid "The intensity of the blur effect."
msgstr "Intenzitet efekta zamućenja."

#: effects/blur/info.js:21 effects/wave/info.js:77
msgid "Brightness"
msgstr "Svjetlina"

#: effects/blur/info.js:22
msgid ""
"The brightness of the blur effect, a high value might make the text harder "
"to read."
msgstr ""
"Svjetlina efekta zamućenja. Visoka vrijednost može otežati čitanje teksta."

#: effects/color/info.js:10 effects/color/info.js:15 effects/color/info.js:41
#: effects/effect_groups.js:11 effects/texture/info.js:51
msgid "Color"
msgstr "Boja"

#: effects/color/info.js:11
msgid "An effect that blends a color into the pipeline."
msgstr "Efekt koji stapa boju sa slikom u nizu efekata."

#: effects/color/info.js:16
msgid ""
"The color to blend in. The blending amount is controlled by the opacity of "
"the color."
msgstr "Boja koja se stapa sa slikom. Količina stapanja određena je neprozirnošću boje."

#: effects/color/info.js:21 effects/texture/info.js:31
msgid "Blend mode"
msgstr "Način stapanja"

#: effects/color/info.js:22
msgid "How the color is blended in."
msgstr "Način stapanja boje sa slikom."

#: effects/color/info.js:25 effects/texture/info.js:35
msgid "Normal"
msgstr "Uobičajeno"

#: effects/color/info.js:26 effects/texture/info.js:36
msgid "Multiply"
msgstr "Množenje"

#: effects/color/info.js:27 effects/texture/info.js:37
msgid "Screen"
msgstr "Zaslon"

#: effects/color/info.js:28 effects/texture/info.js:38
msgid "Overlay"
msgstr "Prekrivanje"

#: effects/color/info.js:29 effects/texture/info.js:39
msgid "Darken"
msgstr "Zatamnjivanje"

#: effects/color/info.js:30 effects/texture/info.js:40
msgid "Lighten"
msgstr "Posvjetljivanje"

#: effects/color/info.js:31 effects/texture/info.js:41
msgid "Plus darker"
msgstr "Dodatno zatamnjivanje"

#: effects/color/info.js:32 effects/texture/info.js:42
msgid "Plus lighter"
msgstr "Dodatno posvjetljivanje"

#: effects/color/info.js:33 effects/texture/info.js:43
msgid "Color dodge"
msgstr "Posvjetljivanje boja"

#: effects/color/info.js:34 effects/texture/info.js:44
msgid "Color burn"
msgstr "Potamnjivanje boja"

#: effects/color/info.js:35 effects/texture/info.js:45
msgid "Hard light"
msgstr "Jako svjetlo"

#: effects/color/info.js:36 effects/texture/info.js:46
msgid "Soft light"
msgstr "Meko svjetlo"

#: effects/color/info.js:37 effects/texture/info.js:47
msgid "Difference"
msgstr "Razlika"

#: effects/color/info.js:38 effects/texture/info.js:48
msgid "Exclusion"
msgstr "Isključivanje"

#: effects/color/info.js:39 effects/texture/info.js:49
msgid "Hue"
msgstr "Nijansa"

#: effects/color/info.js:40 effects/color/info.js:93 effects/texture/info.js:50
#: effects/wave/info.js:67
msgid "Saturation"
msgstr "Zasićenost"

#: effects/color/info.js:42 effects/color/info.js:49 effects/texture/info.js:52
msgid "Luminosity"
msgstr "Osvijetljenost"

#: effects/color/info.js:50
msgid "An effect that affects the luminosity of the image."
msgstr "Efekt koji mijenja osvijetljenost slike."

#: effects/color/info.js:53
msgid "Shift brightness"
msgstr "Pomak svjetline"

#: effects/color/info.js:54
msgid "The brightness to add or remove from the image."
msgstr "Vrijednost svjetline koja se dodaje slici ili oduzima od nje."

#: effects/color/info.js:63
msgid "Brightness multiplier"
msgstr "Množitelj svjetline"

#: effects/color/info.js:64
msgid ""
"Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr "Množi svjetlinu slike; 0 daje crnu boju, a 1 ostavlja svjetlinu nepromijenjenom."

#: effects/color/info.js:73
msgid "Contrast"
msgstr "Kontrast"

#: effects/color/info.js:74
msgid "Adjusts image contrast around the selected contrast center."
msgstr "Prilagođava kontrast slike oko odabranog središta kontrasta."

#: effects/color/info.js:83
msgid "Contrast center"
msgstr "Središte kontrasta"

#: effects/color/info.js:84
msgid "The center of the contrast to use."
msgstr "Središte kontrasta koje će se koristiti."

#: effects/color/info.js:94
msgid ""
"Multiplies image saturation; 0 removes all color and 1 leaves saturation "
"unchanged."
msgstr "Množi zasićenost slike; 0 uklanja sve boje, a 1 ostavlja zasićenost nepromijenjenom."

#: effects/color/info.js:106
msgid "RGB to HSL (advanced effect)"
msgstr "RGB u HSL (napredni efekt)"

#: effects/color/info.js:107
msgid "Converts the image from RGBA color space to HSLA."
msgstr "Pretvara sliku iz prostora boja RGBA u HSLA."

#: effects/color/info.js:112
msgid "HSL to RGB (advanced effect)"
msgstr "HSL u RGB (napredni efekt)"

#: effects/color/info.js:113
msgid "Converts the image from HSLA color space to RGBA."
msgstr "Pretvara sliku iz prostora boja HSLA u RGBA."

#: effects/effect_groups.js:4
msgid "Blur"
msgstr "Zamućenje"

#: effects/effect_groups.js:18
msgid "Texture"
msgstr "Tekstura"

#: effects/effect_groups.js:28
msgid "Advanced"
msgstr "Napredno"

#: effects/effect_groups.js:29
msgid "Building blocks that are mostly useful combined with other effects."
msgstr "Osnovni efekti koji su uglavnom korisni u kombinaciji s drugim efektima."

#: effects/refraction/info.js:7
msgid "Liquid Glass"
msgstr "Liquid Glass"

#: effects/refraction/info.js:8
msgid ""
"A glossy translucent material with edge refraction, rim lighting, tint, and "
"inner shadow."
msgstr "Sjajni proziran materijal s lomom svjetlosti na rubovima, osvijetljenim rubom, nijansom i unutarnjom sjenom."

#: effects/refraction/info.js:11
msgid "Refraction scale"
msgstr "Jačina loma svjetlosti"

#: effects/refraction/info.js:12
msgid "How strongly the glass bends the sampled blur texture."
msgstr "Koliko snažno staklo lomi uzorkovanu zamućenu teksturu."

#: effects/refraction/info.js:21
msgid "Blur radius"
msgstr "Polumjer zamućenja"

#: effects/refraction/info.js:22
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr "Zamućuje uzorkovanu pozadinu prije primjene sjenčara Liquid Glass."

#: effects/refraction/info.js:31
msgid "Bezel width"
msgstr "Širina ruba"

#: effects/refraction/info.js:32
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr "Koliko se leća efekta Liquid Glass proteže prema unutra od ruba."

#: effects/refraction/info.js:41
msgid "Rim spread"
msgstr "Raspon rubnog prijelaza"

#: effects/refraction/info.js:42
msgid "How far the refraction eases inward from the glass edge."
msgstr "Koliko se lom svjetlosti postupno smanjuje prema unutra od ruba stakla."

#: effects/refraction/info.js:51
msgid "Refraction reach"
msgstr "Doseg loma svjetlosti"

#: effects/refraction/info.js:52
msgid ""
"How far the bend reaches inward from the edge, past the corner radius. A "
"wider bend is also deeper, like a wider bezel (0 keeps it at the rim)."
msgstr "Koliko se lom proteže prema unutra od ruba, iza zaobljenog kuta. Širi lom ujedno je i dublji, poput šireg okvira (0 ga zadržava na rubu)."

#: effects/refraction/info.js:61
msgid "Glass thickness"
msgstr "Debljina stakla"

#: effects/refraction/info.js:62
msgid "Depth used by the refraction edge profile."
msgstr "Dubina koja se koristi za profil loma na rubu."

#: effects/refraction/info.js:71
msgid "Refraction style"
msgstr "Oblik loma svjetlosti"

#: effects/refraction/info.js:72
msgid ""
"Shape of the bend near the edge. Low values bend softly, higher values bend "
"more sharply right at the edge."
msgstr "Oblik loma blizu ruba. Niske vrijednosti daju blagi lom, a više vrijednosti oštriji lom neposredno uz rub."

#: effects/refraction/info.js:81
msgid "Fresnel glare"
msgstr "Fresnelov odsjaj"

#: effects/refraction/info.js:82
msgid "Strength of the directional fresnel glare from the glass edge."
msgstr "Jačina usmjerenog Fresnelova odsjaja na rubu stakla."

#: effects/refraction/info.js:91
msgid "Fresnel glare angle"
msgstr "Kut Fresnelova odsjaja"

#: effects/refraction/info.js:92
msgid ""
"Direction or axis of the fresnel glare, in degrees (positive rotates "
"clockwise). In two-sided mode, 0 lights the top and bottom edges; in one-"
"sided mode, only the edge facing the light angle is lit (0 for top, 180 for "
"bottom)."
msgstr "Smjer ili os Fresnelova odsjaja u stupnjevima (pozitivne vrijednosti zakreću ga u smjeru kazaljke na satu). U dvostranom načinu 0 osvjetljava gornji i donji rub; u jednostranom načinu osvijetljen je samo rub okrenut prema svjetlu (0 za gornji, 180 za donji)."

#: effects/refraction/info.js:101
msgid "Fresnel glare width"
msgstr "Širina Fresnelova odsjaja"

#: effects/refraction/info.js:102
msgid "Thickness multiplier of the fresnel glare ring along the glass edge."
msgstr "Množitelj debljine prstena Fresnelova odsjaja duž ruba stakla."

#: effects/refraction/info.js:111
msgid "Two-sided fresnel glare"
msgstr "Dvostrani Fresnelov odsjaj"

#: effects/refraction/info.js:112
msgid ""
"Light opposite edge pairs symmetrically. When disabled, only the edge facing "
"the fresnel angle is lit (e.g. 180 lights the bottom edge, removing the "
"glare from the top)."
msgstr "Simetrično osvjetljava parove suprotnih rubova. Kada je isključeno, osvijetljen je samo rub okrenut prema kutu Fresnelova odsjaja (npr. 180 osvjetljava donji rub i uklanja odsjaj s gornjeg)."

#: effects/refraction/info.js:116
msgid "Specular glare strength"
msgstr "Jačina zrcalnog odsjaja"

#: effects/refraction/info.js:117
msgid ""
"Strength of the white specular glare on the same edge pair as the fresnel "
"glare, brighter on the light side (0 disables it)."
msgstr "Jačina bijelog zrcalnog odsjaja na istom paru rubova kao Fresnelov odsjaj, svjetlijeg na osvijetljenoj strani (0 ga isključuje)."

#: effects/refraction/info.js:126
msgid "Edge border"
msgstr "Obrub ruba"

#: effects/refraction/info.js:127
msgid ""
"Thin dark line along the straight side edges, away from the fresnel glare, "
"outlining the glass on light backgrounds."
msgstr "Tanka tamna crta duž ravnih bočnih rubova, udaljena od Fresnelova odsjaja, koja ocrtava staklo na svijetlim pozadinama."

#: effects/refraction/info.js:136
msgid "Edge glow"
msgstr "Sjaj ruba"

#: effects/refraction/info.js:137
msgid "Colorful content under the glass lights up its edge."
msgstr "Šareni sadržaj ispod stakla osvjetljava njegov rub."

#: effects/refraction/info.js:146
msgid "Tint strength"
msgstr "Jačina nijanse"

#: effects/refraction/info.js:147
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr "Količina suptilne mliječne nijanse stakla preko zamućene teksture."

#: effects/refraction/info.js:156
msgid "Tint color"
msgstr "Boja nijanse"

#: effects/refraction/info.js:157
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr "Boja koja se stapa sa zamućenom teksturom, prema zadanoj jačini nijanse."

#: effects/refraction/info.js:162
msgid "Backdrop zoom"
msgstr "Uvećanje pozadine"

#: effects/refraction/info.js:163
msgid "Zoom level of the backdrop visible through the glass."
msgstr "Razina uvećanja pozadine vidljive kroz staklo."

#: effects/refraction/info.js:172
msgid "Inner shadow"
msgstr "Unutarnja sjena"

#: effects/refraction/info.js:173
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr "Zatamnjuje donji i unutarnji rub kako bi staklena površina dobila dubinu."

#: effects/refraction/info.js:182
msgid "Chromatic dispersion"
msgstr "Kromatska disperzija"

#: effects/refraction/info.js:183
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr "Fizikalna disperzija loma svjetlosti po kanalima na rubu stakla."

#: effects/refraction/info.js:192
msgid "Edge behavior"
msgstr "Ponašanje na rubu"

#: effects/refraction/info.js:193
msgid "How texture coordinates outside the actor are sampled."
msgstr "Način uzorkovanja koordinata teksture izvan elementa."

#: effects/refraction/info.js:196
msgid "Clamp"
msgstr "Ograniči"

#: effects/refraction/info.js:197
msgid "Mirror"
msgstr "Zrcali"

#: effects/texture/info.js:12
msgid "Image"
msgstr "Slika"

#: effects/texture/info.js:13
msgid "Blends an image into the pipeline."
msgstr "Stapa sliku s nizom efekata."

#: effects/texture/info.js:16
msgid "Image path"
msgstr "Putanja slike"

#: effects/texture/info.js:17
msgid "Absolute path to the image file."
msgstr "Apsolutna putanja do slikovne datoteke."

#: effects/texture/info.js:21
msgid "Blend"
msgstr "Stapanje"

#: effects/texture/info.js:22
msgid "How strongly the image is blended in."
msgstr "Koliko se snažno slika stapa s podlogom."

#: effects/texture/info.js:32
msgid "How the image is blended in."
msgstr "Način stapanja slike s podlogom."

#: effects/texture/info.js:56
msgid "Image mode"
msgstr "Način prikaza slike"

#: effects/texture/info.js:57
msgid "Tile the image, stretch it, or fit its width to the monitor."
msgstr "Popločajte sliku, rastegnite je ili prilagodite njezinu širinu zaslonu."

#: effects/texture/info.js:60
msgid "Tile"
msgstr "Popločaj"

#: effects/texture/info.js:61
msgid "Stretch"
msgstr "Rastegni"

#: effects/texture/info.js:62
msgid "Fit width"
msgstr "Prilagodi širinu"

#: effects/texture/info.js:66
msgid "Opacity"
msgstr "Neprozirnost"

#: effects/texture/info.js:67
msgid "Opacity of the image blend."
msgstr "Neprozirnost stopljene slike."

#: effects/texture/info.js:79
msgid "Pixelize"
msgstr "Pikseliziraj"

#: effects/texture/info.js:80
msgid "An effect that pixelizes the image."
msgstr "Efekt koji pikselizira sliku."

#: effects/texture/info.js:83 effects/texture/info.js:108
#: effects/texture/info.js:133
msgid "Factor"
msgstr "Faktor"

#: effects/texture/info.js:84 effects/texture/info.js:109
msgid "How much to scale down the image."
msgstr "Koliko će slika biti umanjena."

#: effects/texture/info.js:91 effects/texture/info.js:116
msgid "Downsampling mode"
msgstr "Način umanjenja slike"

#: effects/texture/info.js:92 effects/texture/info.js:117
msgid "The downsampling method that is used."
msgstr "Korištena metoda umanjenja."

#: effects/texture/info.js:95 effects/texture/info.js:120
msgid "Boxcar"
msgstr "Boxcar"

#: effects/texture/info.js:96 effects/texture/info.js:121
msgid "Triangular"
msgstr "Trokutast"

#: effects/texture/info.js:97 effects/texture/info.js:122
msgid "Dirac"
msgstr "Dirac"

#: effects/texture/info.js:104
msgid "Downscale (advanced effect)"
msgstr "Smanjenje veličine (napredni efekt)"

#: effects/texture/info.js:105
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr "Efekt koji smanjuje sliku i postavlja je u gornji lijevi kut."

#: effects/texture/info.js:129
msgid "Upscale (advanced effect)"
msgstr "Uvećanje (napredni efekt)"

#: effects/texture/info.js:130
msgid "An effect that upscales the image from the top-left corner."
msgstr "Efekt koji uvećava sliku iz gornjeg lijevog kuta."

#: effects/texture/info.js:134
msgid "How much to scale up the image."
msgstr "Koliko će slika biti uvećana."

#: effects/texture/info.js:144
msgid "Derivative"
msgstr "Derivacija"

#: effects/texture/info.js:145
msgid "Apply a spatial derivative, or a laplacian."
msgstr "Primjenjuje prostornu derivaciju ili Laplaceov operator."

#: effects/texture/info.js:148
msgid "Operation"
msgstr "Operacija"

#: effects/texture/info.js:149
msgid "The mathematical operation to apply."
msgstr "Primijenjena matematička operacija."

#: effects/texture/info.js:152
msgid "1-step derivative"
msgstr "Derivacija u jednom koraku"

#: effects/texture/info.js:153
msgid "2-step derivative"
msgstr "Derivacija u dva koraka"

#: effects/texture/info.js:154
msgid "Laplacian"
msgstr "Laplaceov operator"

#: effects/texture/info.js:161 effects/texture/info.js:165
msgid "Noise"
msgstr "Šum"

#: effects/texture/info.js:162
msgid "An effect that adds random grain to the image."
msgstr "Efekt koji slici dodaje nasumičnu zrnatost."

#: effects/texture/info.js:166
msgid "The amount of noise to add."
msgstr "Količina šuma koja će biti dodana."

#: effects/texture/info.js:175
msgid "Lightness"
msgstr "Svjetlina"

#: effects/texture/info.js:176
msgid ""
"The luminosity of the noise. A setting of '1.0' will make the effect "
"transparent."
msgstr "Svjetlina šuma. Postavka 1.0 učinit će efekt prozirnim."

#: effects/wave/info.js:7
msgid "Vapor Wave"
msgstr "Vapor Wave"

#: effects/wave/info.js:8
msgid ""
"A flowing wave displacement for a lively and dynamic feel with natural "
"movement."
msgstr "Valovito pomicanje s prirodnim kretanjem za živahan i dinamičan dojam."

#: effects/wave/info.js:11
msgid "Wave frequency"
msgstr "Frekvencija valova"

#: effects/wave/info.js:12
msgid "How tightly packed the ripples are."
msgstr "Koliko su valovi gusto raspoređeni."

#: effects/wave/info.js:21
msgid "Wave amplitude"
msgstr "Amplituda valova"

#: effects/wave/info.js:22
msgid "How strongly the image gets displaced by the waves."
msgstr "Koliko snažno valovi pomiču sliku."

#: effects/wave/info.js:31
msgid "Wave octaves"
msgstr "Oktave valova"

#: effects/wave/info.js:32
msgid ""
"Detail level of the wave shape. Higher adds more detail at the cost of "
"performance."
msgstr "Razina detalja oblika vala. Viša vrijednost dodaje više detalja na štetu performansi."

#: effects/wave/info.js:39
msgid "Vapor octaves"
msgstr "Oktave pare"

#: effects/wave/info.js:40
msgid ""
"Detail level of the misty texture. Higher adds more detail at the cost of "
"performance."
msgstr "Razina detalja magličaste teksture. Viša vrijednost dodaje više detalja na štetu performansi."

#: effects/wave/info.js:47
msgid "Vapor speed"
msgstr "Brzina pare"

#: effects/wave/info.js:48
msgid "How quickly the misty vapor texture drifts over time."
msgstr "Koliko se brzo magličasta tekstura pare pomiče tijekom vremena."

#: effects/wave/info.js:57
msgid "Texture grain"
msgstr "Zrnatost teksture"

#: effects/wave/info.js:58
msgid "Adds a fine sandblasted texture to the image."
msgstr "Dodaje slici finu teksturu nalik pjeskarenoj površini."

#: effects/wave/info.js:68
msgid "The saturation of the effect."
msgstr "Zasićenost efekta."

#: effects/wave/info.js:78
msgid "The brightness of the effect."
msgstr "Svjetlina efekta."

#: effects/wave/info.js:87
msgid "Zoom"
msgstr "Uvećanje"

#: effects/wave/info.js:88
msgid "Magnifies the backdrop toward the surface's center."
msgstr "Uvećava pozadinu prema središtu površine."

#: effects/wave/info.js:97
msgid "Dispersion"
msgstr "Disperzija"

#: effects/wave/info.js:98
msgid "Chromatic aberration strength for a glitchy feel."
msgstr "Jačina kromatske aberacije za dojam digitalne smetnje."

#: effects/wave/info.js:107
msgid "Enable flow animation"
msgstr "Omogući animaciju protoka"

#: effects/wave/info.js:108
msgid "Whether the wave noise continuously flows over time."
msgstr "Određuje pomiče li se valoviti šum neprekidno."

#: effects/wave/info.js:112
msgid "Flow animation speed"
msgstr "Brzina animacije protoka"

#: effects/wave/info.js:113
msgid "The base speed at which the wave pattern flows."
msgstr "Osnovna brzina kretanja valovitog uzorka."

#: effects/wave/info.js:122
msgid "Resize ease duration"
msgstr "Trajanje prilagodbe promjeni veličine"

#: effects/wave/info.js:123
msgid ""
"How long the effect takes to adjust when a window changes size "
"(milliseconds)."
msgstr "Koliko je vremena efektu potrebno da se prilagodi promjeni veličine prozora (u milisekundama)."

#: preferences/legacy_blur_notice.js:26
msgid "Rounded-blur is no longer needed"
msgstr "Rounded-blur više nije potreban"

#: preferences/legacy_blur_notice.js:27
msgid ""
"Blur my Shell handles rounded corners directly. You can remove the old "
"library if nothing else uses it."
msgstr "Blur my Shell sam obrađuje zaobljene kutove. Staru biblioteku možete ukloniti ako je ništa drugo ne koristi."

#: preferences/legacy_blur_notice.js:31
msgid "Removal instructions"
msgstr "Upute za uklanjanje"

#: preferences/legacy_blur_notice.js:37 preferences/legacy_blur_notice.js:43
msgid "Dismiss"
msgstr "Odbaci"

#: preferences/legacy_blur_notice.js:58
msgid "Removing the old blur library"
msgstr "Uklanjanje stare biblioteke za zamućenje"

#: preferences/legacy_blur_notice.js:60
msgid ""
"Removal is optional. Keep the library if another extension still needs it."
msgstr "Uklanjanje je neobavezno. Zadržite biblioteku ako je drugoj ekstenziji još potrebna."

#: preferences/legacy_blur_notice.js:61
msgid ""
"Installed through a package manager? Remove the gnome-rounded-blur package "
"with the same package manager. Review its proposed changes before confirming."
msgstr "Instalirano upraviteljem paketa? Uklonite paket gnome-rounded-blur istim upraviteljem paketa. Prije potvrde pregledajte predložene promjene."

#: preferences/legacy_blur_notice.js:62
msgid ""
"Installed with the old Blur my Shell helper? The instructions explain how to "
"run its uninstaller."
