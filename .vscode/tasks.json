{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Translation: update PO from POT",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/translate.sh", "update", "${input:package}"],
            "problemMatcher": []
        },
        {
            "label": "Translation: check",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/translate.sh", "check", "${input:package}"],
            "problemMatcher": []
        },
        {
            "label": "Translation: build MO",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/translate.sh", "build", "${input:package}"],
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "package",
            "type": "promptString",
            "description": "Package directory name",
            "default": "control-panel"
        }
    ]
}
