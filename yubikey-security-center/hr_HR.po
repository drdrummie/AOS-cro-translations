msgstr "Prije potpisivanja učitaj ovaj rezidentni ključ u SSH agenta"

msgid "Loaded"
msgstr "Učitano"

msgid "Loading SSH keys… Touch the YubiKey if it flashes."
msgstr "Učitavaju se SSH ključevi… Dodirnite YubiKey ako počne treperiti."

