msgid ""
"DKMS and the matching kernel headers are required. Check the driver build "
"requirements."
msgstr "Potrebni su DKMS i odgovarajuća zaglavlja jezgre. Provjerite preduvjete za izgradnju upravljačkog programa."

msgid "Default printer"
msgstr "Zadani pisač"

msgid "Deploy the installed recovery image and regenerate the GRUB menu?"
msgstr "Postaviti instaliranu sliku za oporavak i ponovno izraditi izbornik GRUB-a?"

