msgstr "Pomoć za oporavak pokretanja"

msgid "Bootloader Update Failed"
msgstr "Ažuriranje pokretačkog programa nije uspjelo"

msgid "Bootloader Updated"
msgstr "Pokretački program je ažuriran"

